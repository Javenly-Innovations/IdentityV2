# Javenly Identity — Environment Configuration Template
# Operating cost: $0.00/month (Supabase Auth Free Tier + Cloudflare Pages)

# Supabase Free Tier Configuration
# Retrieve from: Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Identity Subdomain URLs
VITE_IDENTITY_URL="https://identity.javenly.com"
VITE_ACCOUNT_URL="https://account.javenly.com"
VITE_ADMIN_URL="https://admin-identity.javenly.com"
VITE_API_URL="https://api-identity.javenly.com"

# Connected Application Clients
JAVENLY_WORDPRESS_CLIENT_ID="client_jav_wordpress_javenly_com"
JAVENLY_WORDPRESS_CLIENT_SECRET="sec_live_example_secret_for_wordpress_backend"

JAVENLY_CRM_CLIENT_ID="client_jav_crm_nodejs_app"
JAVENLY_CRM_CLIENT_SECRET="sec_live_example_secret_for_crm_backend"
